# 数据库连接（MySQL + asyncmy）
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/exam_system

# Redis 连接
REDIS_URL=redis://localhost:6379/0

# JWT 配置（生产环境务必替换为强随机密钥）
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 上传目录（相对路径，相对 backend/ 启动目录）
UPLOAD_DIR=./uploads

# AI subjective grading (OpenAI-compatible endpoint)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_WORKER_POLL_SECONDS=1.0
